<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="yireo_events_logger" translate="label" sortOrder="900" showInDefault="1">
            <label>Yireo Events Logger</label>
            <tab>advanced</tab>
            <resource>Yireo_EventsLogger::config</resource>
            <group id="general" translate="label" type="text" sortOrder="1" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="1" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Debug only. Logs every dispatched event to var/log/events.log. This file is not rotated, so do not leave this enabled in production.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
